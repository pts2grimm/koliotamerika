# Run npm run setup to create a local secret. Never commit .env.
PAYLOAD_SECRET=
DATABASE_URI=file:./.data/payload.db
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Hosted uploads: absolute writable path OUTSIDE hbuilds/versions; preserve it during domain moves.
# MEDIA_DIR=/absolute/persistent/storage/media
# Keep false until real content, privacy policy and redirects are approved.
SITE_INDEXABLE=false
# Temporary bridge; replace before moving the public domain away from WordPress.
AUCTION_API_BASE_URL=https://koliotamerika.bg/wp-json/koa/v1
# Enable only behind a controlled proxy that overwrites forwarding headers.
TRUST_PROXY=false
# Supply APICAR_API_KEY securely in environment settings; never commit its value.
# AUCTION_PROVIDER=apicar
# Requires APICAR_API_KEY; otherwise the legacy bridge above still depends on WordPress.
APICAR_VIN_ENABLED=false
AUCTION_LOGGING=false
# Optional read-only demo: PREVIEW_MODE=true (temporary content, no admin/inquiries).

# Enable only with persistent storage and an administrator already provisioned.
CUSTOMER_ACCOUNTS_ENABLED=false
# For hosted SQLite (Turso): DATABASE_URI=libsql://your-database.turso.io
# DATABASE_AUTH_TOKEN= (secret; required for remote database)
# SMTP enables password recovery and saved-inquiry notifications to Site Settings -> email.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM=
# SMTP_USER=
# SMTP_PASSWORD= (secret)
# One-time admin provisioning; remove these after first successful initialization.
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD= (secret, at least 8 characters)
