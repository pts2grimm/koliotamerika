# Run npm run setup to create a local secret. Never commit .env.
PAYLOAD_SECRET=
DATABASE_URI=file:./.data/payload.db
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Keep false until real content, privacy policy and redirects are approved.
SITE_INDEXABLE=false
# Temporary bridge; replace before moving the public domain away from WordPress.
AUCTION_API_BASE_URL=https://koliotamerika.bg/wp-json/koa/v1
# Enable only behind a controlled proxy that overwrites forwarding headers.
TRUST_PROXY=false
# Supply APICAR_API_KEY securely in environment settings; never commit its value.
# AUCTION_PROVIDER=apicar
APICAR_VIN_ENABLED=false
AUCTION_LOGGING=false
# Optional read-only demo: PREVIEW_MODE=true (temporary content, no admin/inquiries).
